#cloud-config
hostname: ${hostname}
users:
  - name: ops
    groups: [sudo]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    ssh_authorized_keys:
      - ${ssh_key}
ssh_pwauth: false
package_update: true
packages:
  - qemu-guest-agent
  - nginx
write_files:
  - path: /var/www/html/index.html
    content: |
      <h1>${hostname}</h1>
      <p>Provisioned from blueprint ${blueprint}. Database endpoint: ${db_host}:${db_port}</p>
  - path: /etc/tdgov/blueprint
    content: "${blueprint}\n"
runcmd:
  - systemctl enable --now qemu-guest-agent
  - systemctl enable --now nginx
